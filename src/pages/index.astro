---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="GenCSS + Astro Starter">
  <main>
    <section class="l-section c-hero">
      <div class="l-container">
        <div class="c-hero__inner">
          <span class="c-hero__badge">GenCSS Starter Template</span>
          <h1 class="c-hero__title">
            Engineered with <span class="c-hero__highlight">Astro &amp; GenCSS</span>
          </h1>
          <p class="c-hero__lead">
            A production-ready starter featuring fluid design tokens, BEM methodology, CSS logical properties, and zero build-time utility soup.
          </p>
          <div class="c-hero__actions">
            <a href="https://github.com/gdcrosbie/astro-gencss-starter" class="c-btn c-btn--primary">
              GitHub Repository
            </a>
            <a href="#features" class="c-btn c-btn--secondary">
              Explore Architecture
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="l-section l-section--bordered c-features">
      <div class="l-container">
        <header class="c-features__header">
          <span class="c-features__label">Core Primitives</span>
          <h2 class="c-features__title">Built for Performance and Clean Styling</h2>
        </header>

        <div class="c-features__grid">
          <article class="c-card">
            <h3 class="c-card__title">Tokenized Primitives</h3>
            <p class="c-card__body">
              Pure GenCSS custom properties for spacing, typography, colors, and shadows without runtime overhead.
            </p>
          </article>

          <article class="c-card">
            <h3 class="c-card__title">Strict BEM Architecture</h3>
            <p class="c-card__body">
              Every component uses scoped, semantic BEM classes (`.c-block__element--modifier`) that never leak styles.
            </p>
          </article>

          <article class="c-card">
            <h3 class="c-card__title">CSS Logical Properties</h3>
            <p class="c-card__body">
              Modern flow-relative dimensions (`padding-block`, `margin-inline`, `max-inline-size`) for robust internationalization.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .c-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-inline-size: 840px;
  }

  .c-hero__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-heading);
    color: var(--primary);
    background-color: var(--primary-trans20);
    border: 1px solid var(--primary-trans40);
    padding-block: 0.3em;
    padding-inline: 0.75em;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-block-end: var(--space-m);
  }

  .c-hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-display);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    color: var(--color);
    margin-block-end: var(--space-m);
  }

  .c-hero__highlight {
    color: var(--primary);
  }

  .c-hero__lead {
    font-size: var(--text-m);
    color: var(--color-muted);
    line-height: var(--leading-body);
    max-inline-size: 65ch;
    margin-block-end: var(--space-xl);
  }

  .c-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-s);
  }

  /* Buttons */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-block: 0.6em;
    padding-inline: 1.35em;
    font-size: var(--text-s);
    font-weight: var(--weight-heading);
    border-radius: var(--radius-s);
    transition: var(--transition-base);
    text-decoration: none;
    line-height: 1;
    cursor: pointer;
  }

  .c-btn--primary {
    background-color: var(--primary);
    color: var(--primary-light-2);
    border: 1px solid var(--primary);
  }

  .c-btn--primary:hover {
    background-color: var(--primary-dark-1);
    border-color: var(--primary-dark-1);
  }

  .c-btn--secondary {
    background-color: var(--surface-raised);
    color: var(--color);
    border: 1px solid var(--border-color);
  }

  .c-btn--secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Features */
  .c-features__header {
    max-inline-size: 640px;
    margin-block-end: var(--space-xl);
  }

  .c-features__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-heading);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-block-end: var(--space-xs);
  }

  .c-features__title {
    font-family: var(--font-heading);
    font-size: var(--h2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    color: var(--color);
  }

  .c-features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap-grid);
  }

  /* Cards */
  .c-card {
    background-color: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-card);
    padding: var(--space-l);
    box-shadow: var(--shadow-card);
    transition: var(--transition-base);
  }

  .c-card:hover {
    border-color: var(--white-20);
    box-shadow: var(--shadow-l);
    transform: translateY(-2px);
  }

  .c-card__title {
    font-family: var(--font-heading);
    font-size: var(--h3);
    font-weight: var(--weight-heading);
    color: var(--color);
    margin-block-end: var(--space-xs);
  }

  .c-card__body {
    font-size: var(--text-s);
    color: var(--color-muted);
    line-height: var(--leading-body);
  }
</style>
